# Godot 4+ specific ignores
.godot/
/android/

# 引擎本体与随附 C# 运行时（随引擎分发，可随时重新获取，不入库）
/GodotSharp/
/Godot_v*.exe

# C# / Mono 构建产物（仅项目根，避免误伤源码子目录）
/bin/
/obj/
**/bin/
**/obj/
*.csproj.user

# IDE
.vs/
.vscode/
.idea/

# Agent 工具产物
.gdskills/
shot_*.png

# 原始设计源文件（放进项目前加 .gdignore 或留在外部）
*.psd
*.blend

